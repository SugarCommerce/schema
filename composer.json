{
  "name": "sugarcommerce/schema",
  "description": "Describe a WordPress plugin's custom tables in one JSON file and generate the BerlinDB classes, the CRUD functions and the table versions from it.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/schema",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "wordpress",
    "berlindb",
    "custom-tables",
    "code-generator",
    "schema",
    "crud",
    "dev-tool"
  ],
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Schema\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Schema\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/fixtures/"
    ]
  },
  "bin": [
    "bin/schema"
  ],
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  },
  "support": {
    "issues": "https://github.com/sugarcommerce/schema/issues",
    "source": "https://github.com/sugarcommerce/schema"
  }
}
